{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/run_state.schema.json",
  "title": "Run state",
  "description": "Project state.json — the resumability contract.",
  "type": "object",
  "required": [
    "slug",
    "title",
    "question",
    "profile",
    "created_at",
    "updated_at",
    "counters",
    "budget",
    "phases",
    "ran"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
    },
    "title": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "profile": {
      "enum": [
        "quick",
        "standard",
        "deep",
        "max"
      ]
    },
    "deliverable_type": {
      "enum": [
        "report",
        "academic-paper",
        "academic-manuscript",
        "decision-framework",
        "memo",
        "osint-brief",
        "dataset"
      ],
      "default": "report"
    },
    "review_protocol": {
      "enum": [
        "",
        "prisma",
        "systematic-review",
        "none"
      ],
      "default": ""
    },
    "key_studies_target": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "key studies required in the literature matrix (academic deliverables)"
    },
    "project_dir": {
      "type": "string",
      "description": "absolute path where the project lives (user-chosen output location)"
    },
    "vault_base": {
      "type": ["string", "null"],
      "description": "vault root the project was created under (null when --dir was used)"
    },
    "privacy_mode": {
      "type": "boolean",
      "default": false
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "phase_current": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "counters": {
      "type": "object",
      "properties": {
        "searches": {
          "type": "integer",
          "minimum": 0
        },
        "sources_read": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "verify_passes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "ceilings",
        "spent_usd"
      ],
      "properties": {
        "ceilings": {
          "type": "object"
        },
        "spent_usd": {
          "type": "number",
          "minimum": 0
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "counter",
              "ceiling",
              "actual",
              "reason",
              "at"
            ],
            "properties": {
              "counter": {
                "type": "string"
              },
              "ceiling": {
                "type": "integer"
              },
              "actual": {
                "type": "integer"
              },
              "reason": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "phases": {
      "type": "object",
      "description": "per-phase completion + waivers, keyed by phase number string",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "completed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "waivers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "check",
                "reason",
                "at"
              ],
              "properties": {
                "check": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "gate_waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "phase",
          "check",
          "reason",
          "at"
        ],
        "properties": {
          "phase": {
            "type": "integer"
          },
          "check": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "ran": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "last_verify_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_contradictions_scan_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_credibility_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_report_check_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "preferences_asked": {
      "type": "integer",
      "minimum": 0
    },
    "source_health": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "attempts": {
            "type": "integer"
          },
          "failures": {
            "type": "integer"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "capability_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "type": "string"
    },
    "manuscript": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "style": {
          "enum": [
            "apa",
            "vancouver",
            "ieee"
          ]
        },
        "reporting_guidelines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "venue_path": {
          "type": "string"
        },
        "last_check_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fulltext_policy": {
      "type": "object",
      "properties": {
        "min_verified_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "max_abstract_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.2
        },
        "key_studies_require_verified": {
          "type": "boolean",
          "default": true
        },
        "critical_claims_require_verified": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
