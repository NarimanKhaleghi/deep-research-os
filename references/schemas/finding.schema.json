{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/finding.schema.json",
  "title": "Finding front-matter",
  "description": "YAML-ish front-matter of findings/FN-##.md (parsed without PyYAML).",
  "type": "object",
  "required": ["id", "title", "strength", "confidence", "claims", "counterpoints", "gaps"],
  "properties": {
    "id": { "type": "string", "pattern": "^FN-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 6 },
    "strength": { "enum": ["established", "supported", "tentative"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "kind": { "enum": ["analysis", "model", "scenarios", "sensitivity", "literature-matrix", "methodology", "conclusion"], "default": "analysis", "description": "model/scenarios/sensitivity are required for academic-paper deliverables (phase-7 gate findings_kinds)" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^CL-[0-9]{4}$" }
    },
    "counterpoints": {
      "type": "array",
      "items": { "type": "string" },
      "description": "claim/contradiction IDs with a note; empty list allowed"
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "what a skeptic would still want; rolls up to Limitations"
    },
    "angles": { "type": "array", "items": { "type": "string" } },
    "section": { "enum": ["summary", "main", "appendix"] }
  }
}
