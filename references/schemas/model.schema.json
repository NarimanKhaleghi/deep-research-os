{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/model.schema.json",
  "title": "Model card",
  "description": "Project-level model.json: variables, equations, exact cases, comparator dimensions, sensitivity and scope disclosure.",
  "type": "object",
  "required": ["schema_version", "title", "scope", "variables", "equations", "cases"],
  "properties": {
    "schema_version": { "enum": ["1.0", 1, 1.0] },
    "title": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["structure", "implemented_stages", "learning", "selection"],
      "properties": {
        "structure": { "enum": ["single-stage", "multi-stage"] },
        "implemented_stages": { "type": "integer", "minimum": 1 },
        "total_stages": { "type": "integer", "minimum": 1 },
        "learning": { "type": "boolean" },
        "selection": { "enum": ["none", "greedy", "ranking", "heuristic", "optimization", "exact"] },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["symbol", "name", "role", "baseline", "source"],
        "properties": {
          "symbol": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "name": { "type": "string" },
          "role": { "enum": ["input", "parameter", "probability", "state", "constant"] },
          "unit": { "type": "string" },
          "baseline": { "type": "number" },
          "range": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
          "source": { "type": "string", "description": "SRC-#### or ASSUMPTION" },
          "assumption": { "type": "string" }
        }
      }
    },
    "equations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "output", "expression"],
        "properties": {
          "id": { "type": "string" },
          "output": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "expression": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "comparators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_ids", "dimensions", "where_it_differs"],
        "properties": {
          "name": { "type": "string" },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dimensions": {
            "type": "object",
            "required": ["cost_of_delay", "staging", "learning"],
            "properties": {
              "cost_of_delay": { "enum": ["yes", "partial", "no", "na"] },
              "staging": { "enum": ["yes", "partial", "no", "na"] },
              "learning": { "enum": ["yes", "partial", "no", "na"] }
            }
          },
          "dimension_notes": { "type": "object", "additionalProperties": { "type": "string" } },
          "where_it_differs": { "type": "string" }
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["method", "case_id"],
      "properties": {
        "method": { "type": "string" },
        "case_id": { "type": "string" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["baseline", "scenario", "sensitivity"] },
          "label": { "type": "string" },
          "inputs": { "type": "object", "additionalProperties": { "type": "number" } },
          "outputs": { "type": "object", "additionalProperties": { "type": "number" } },
          "decision": { "type": "string" },
          "early_warning": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "sensitivity": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parameter", "case_ids", "breakpoint"],
        "properties": {
          "parameter": { "type": "string" },
          "case_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "breakpoint": { "type": "string" }
        }
      }
    },
    "reproduction": {
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
