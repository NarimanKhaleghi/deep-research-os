{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/retrospective.schema.json",
  "title": "Retrospective record",
  "description": "retrospective.json (phase 9 output feeding the learning loop).",
  "type": "object",
  "required": [
    "slug",
    "at",
    "worked",
    "failed",
    "budget_used",
    "metrics",
    "suggestions",
    "capability_candidate"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "at": {
      "type": "string"
    },
    "worked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_used": {
      "type": "object",
      "properties": {
        "searches": {
          "type": "integer"
        },
        "sources_read": {
          "type": "integer"
        },
        "evidence": {
          "type": "integer"
        },
        "claims": {
          "type": "integer"
        },
        "verify_passes": {
          "type": "integer"
        },
        "spent_usd": {
          "type": "number"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "citation_precision": {
          "type": [
            "number",
            "null"
          ]
        },
        "verify_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "contradictions": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer"
            },
            "adjudicated": {
              "type": "integer"
            },
            "open": {
              "type": "integer"
            }
          }
        },
        "phases_completed": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_candidate": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "capability_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "feedback_skipped": {
      "type": "boolean",
      "default": false
    },
    "feedback_skip_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
