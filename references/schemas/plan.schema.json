{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/plan.schema.json",
  "title": "Plan front-matter",
  "description": "Optional front-matter of plan.md (phases 1–2 contract). Plan files without front-matter validate as an empty object; body sections are checked by the phase gates.",
  "type": "object",
  "properties": {
    "planned_at": { "type": "string" },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["q"],
        "properties": {
          "q": { "type": "string" },
          "angle": { "type": "string" },
          "strategy": { "enum": ["broad", "targeted", "snowball-back", "snowball-forward", "browse"] },
          "sources": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["planned", "done", "skipped"] }
        }
      }
    },
    "stop_rules": { "type": "array", "items": { "type": "string" } },
    "budget_split": { "type": "object", "description": "angle -> counters allocated" },
    "saturated_angles": { "type": "array", "items": { "type": "string" } }
  }
}
