{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/requirements.schema.json",
  "title": "Requirements ledger",
  "description": "requirements.json — every explicit user requirement tracked to the report. `report build` hard-gates until each is mapped (anchor present in report text) or waived with a reason.",
  "type": "object",
  "required": ["schema", "requirements"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "origin", "mappings", "created_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^RQ-[0-9]{2,}$" },
          "text": { "type": "string", "minLength": 4 },
          "origin": { "type": "string", "description": "where the requirement came from (default: user prompt)" },
          "mappings": {
            "type": "array",
            "items": { "type": "string" },
            "description": "report section headings or finding ids fulfilling the requirement; anchor tokens must appear in report.md"
          },
          "waiver": {
            "type": ["object", "null"],
            "required": ["reason", "at"],
            "properties": {
              "reason": { "type": "string", "minLength": 4 },
              "at": { "type": "string" }
            }
          },
          "created_at": { "type": "string" }
        }
      }
    }
  }
}
