{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-research-os.dev/schemas/searchlog.schema.json",
  "title": "Search log entry",
  "description": "One line of searches.jsonl (SCH-####) — the reproducibility journal behind the report's search & screening block.",
  "type": "object",
  "required": ["id", "at", "query", "engine"],
  "properties": {
    "id": { "type": "string", "pattern": "^SCH-[0-9]{4}$" },
    "at": { "type": "string", "description": "ISO 8601 timestamp" },
    "query": { "type": "string", "minLength": 1 },
    "engine": { "type": "string", "description": "connector route name or manual engine (google, searxng, scholar, …)" },
    "manual": { "type": "boolean", "description": "true when recorded via `searchlog add`" },
    "domains": { "type": "array", "items": { "type": "string" } },
    "angle": { "type": ["string", "null"], "description": "research angle this search served" },
    "chosen": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" },
    "failures": { "type": "array", "items": { "type": "string" } },
    "hits": { "type": "integer", "minimum": 0 },
    "kept": { "type": "integer", "minimum": 0 },
    "urls": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": ["string", "null"] }
  }
}
