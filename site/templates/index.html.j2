<!doctype html>
<html lang="{{ cfg.html_lang }}" dir="{{ cfg.dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
<meta name="author" content="{{ site.author }}">
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href="{{ canonical }}">
<link rel="alternate" hreflang="en" href="{{ site.base_url }}">
<link rel="alternate" hreflang="fa" href="{{ site.base_url }}fa/">
<link rel="alternate" hreflang="x-default" href="{{ site.base_url }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.site_name }}">
<meta property="og:title" content="{{ meta.og_title }}">
<meta property="og:description" content="{{ meta.og_description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.base_url }}{{ cfg.og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ meta.og_title }}">
<meta property="og:locale" content="{{ cfg.og_locale }}">
<meta property="og:locale:alternate" content="{{ cfg.alternate_locale }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ meta.og_title }}">
<meta name="twitter:description" content="{{ meta.og_description }}">
<meta name="twitter:image" content="{{ site.base_url }}{{ cfg.og_image }}">

<meta name="theme-color" content="#f4f1e8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#101412" media="(prefers-color-scheme: dark)">
<link rel="icon" href="{{ asset_prefix }}assets/favicon.svg" type="image/svg+xml">
{% if cfg.html_lang == "fa" %}
<link rel="preload" href="{{ asset_prefix }}assets/fonts/vazirmatn-var.woff2" as="font" type="font/woff2" crossorigin>
{% else %}
<link rel="preload" href="{{ asset_prefix }}assets/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ asset_prefix }}assets/fonts/source-serif-var.woff2" as="font" type="font/woff2" crossorigin>
{% endif %}
<link rel="stylesheet" href="{{ asset_prefix }}assets/site.css?v={{ asset_version }}">
<script type="application/ld+json">{{ jsonld | safe }}</script>
<script>
(function(){document.documentElement.classList.add("js");try{var t=localStorage.getItem("dro.theme");if(t){document.documentElement.setAttribute("data-theme",t);}}catch(e){}})();
</script>
</head>
<body>
<a class="skip" href="#main">{{ skip }}</a>

<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="{{ home_href }}" aria-label="{{ site.site_name }} — home">
      <span class="mark" aria-hidden="true">◈</span> {{ site.site_name }}
    </a>
    <nav class="navlinks" id="navlinks" aria-label="Primary">
      <a href="#how">{{ nav.how }}</a>
      <a href="#evidence">{{ nav.evidence }}</a>
      <a href="#validation">{{ nav.validation }}</a>
      <a href="#install">{{ nav.install }}</a>
    </nav>
    <div class="tools">
      <a class="langbtn" href="{{ cfg.switch_path }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}">{{ cfg.switch_label }}</a>
      <button class="iconbtn" id="theme-toggle" type="button" aria-pressed="false" aria-label="{{ theme }}" title="{{ theme }}">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a class="gh" href="{{ site.repo_url }}">{{ nav.github }} <span aria-hidden="true">↗</span></a>
      <button class="burger" id="menu-toggle" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="{{ nav.menu }}">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<main id="main">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{{ hero.eyebrow }}</p>
        <h1>{{ hero.h1 | safe }}</h1>
        <p class="lede">{{ hero.lede }}</p>
        <div class="cta">
          <a class="btn primary" href="#install">{{ hero.cta_primary }}</a>
          <a class="btn ghost" href="{{ site.repo_url }}">{{ hero.cta_secondary }}</a>
          <a class="link-arrow" href="{{ preview.sample_path }}">{{ hero.cta_tertiary }} <span aria-hidden="true">↗</span></a>
        </div>
        <ul class="proof">
          {% for item in hero.proof %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </div>
      <div class="hero-art">
        <div class="slip">{{ hero.ledger.slip }}</div>
        <div class="ledger" aria-label="{{ hero.ledger.title }}">
          <div class="lhead"><span class="mono">{{ hero.ledger.title }}</span><span class="live mono"><i aria-hidden="true"></i>{{ hero.ledger.live }}</span></div>
          {% for row in hero.ledger.rows %}
          <div class="lrow" style="--i:{{ loop.index0 }}">
            <p class="lclaim">{{ row.claim }}</p>
            <span class="lsrc">{{ row.ids }}</span>
            <span class="chip verified">{{ row.verdict }}</span>
          </div>
          {% endfor %}
          <div class="lfoot"><span>{{ hero.ledger.foot_left }}</span><span>{{ hero.ledger.foot_right }}</span></div>
        </div>
        <div class="stamp">{{ hero.ledger.stamp }}</div>
      </div>
    </div>
  </section>

  <section class="metrics" aria-label="Key numbers">
    <div class="wrap">
      <div class="band">
        {% for m in metrics %}
        <div class="metric"><div class="mvalue" data-count="{{ m.value }}">{{ m.value }}</div><div class="mlabel">{{ m.label }}</div></div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section" id="how">
    <div class="wrap">
      <div class="fhead reveal">
        <div><p class="kicker">{{ features.kicker }}</p><h2>{{ features.title }}</h2></div>
        <p>{{ features.desc }}</p>
      </div>
      <div class="fgrid">
        {% for item in features["items"] %}
        <article class="fitem reveal" style="--i:{{ loop.index0 }}">
          <div class="fnum">{{ item.n }}</div>
          <h3>{{ item.title }}</h3>
          <p>{{ item.desc }}</p>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section" id="pipeline">
    <div class="wrap">
      <div class="fhead reveal">
        <div><p class="kicker">{{ pipeline.kicker }}</p><h2>{{ pipeline.title }}</h2></div>
        <p>{{ pipeline.desc }}</p>
      </div>
      <ol class="phases">
        {% for p in pipeline.phases %}
        <li class="phase reveal" style="--i:{{ loop.index0 }}">
          <span class="pnum">{{ p.n }}</span>
          <div class="pbody">
            <h3>{{ p.name }}</h3>
            <p>{{ p.desc }}</p>
            <span class="pgate"><span>{{ pipeline.gate_label }}</span> {{ p.gate }}</span>
          </div>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section class="section preview" id="evidence">
    <div class="wrap pgrid">
      <div class="pintro reveal">
        <p class="kicker">{{ preview.kicker }}</p>
        <h2>{{ preview.title }}</h2>
        <p>{{ preview.desc }}</p>
        <a class="plink" href="{{ preview.sample_path }}">{{ preview.link }} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sheet reveal" style="--i:1">
        <aside class="toc" aria-label="Report contents">
          {% for item in preview.toc %}
          <div{% if loop.index == 3 %} class="on"{% endif %}><span>{{ "%02d"|format(loop.index) }}</span><span>{{ item }}</span></div>
          {% endfor %}
        </aside>
        <article class="doc">
          <span class="mono dsub">{{ preview.sub }}</span>
          <h3>{{ preview.title_short }}</h3>
          <div class="docmeta">{% for m in preview.meta %}<span>{{ m }}</span>{% endfor %}</div>
          <div class="rstats">
            {% for s in preview.stats %}
            <div class="rstat"><b>{{ s.value }}</b><span>{{ s.label }}</span></div>
            {% endfor %}
          </div>
          <p class="rtext">{{ preview.excerpt }}</p>
          <span class="mono refs">{{ preview.refs }}</span>
          <div class="refline w90"></div><div class="refline w65"></div><div class="refline w80"></div><div class="refline w65"></div>
        </article>
      </div>
    </div>
  </section>

  <section class="section validation" id="validation">
    <div class="wrap">
      <div class="fhead reveal">
        <div><p class="kicker">{{ validation.kicker }}</p><h2>{{ validation.title }}</h2></div>
        <p>{{ validation.desc }}</p>
      </div>
      <div class="vstats reveal">
        {% for s in validation.stats %}
        <div class="vstat"><b data-count="{{ s.value }}">{{ s.value }}</b><span>{{ s.label }}</span></div>
        {% endfor %}
      </div>
      <div class="evals reveal">
        <div class="evals-head">
          <h3>{{ validation.evals_title }}</h3>
          <p class="mono">{{ validation.note }}</p>
        </div>
        <ol class="evals-grid">
          {% for e in validation.evals %}<li>{{ e }}</li>{% endfor %}
        </ol>
      </div>
    </div>
  </section>

  <section class="section install" id="install">
    <div class="wrap install-grid">
      <div class="pintro reveal">
        <p class="kicker">{{ install.kicker }}</p>
        <h2>{{ install.title }}</h2>
        <p>{{ install.desc }}</p>
        <p class="platforms">{{ install.platforms }}</p>
        <a class="plink" href="{{ site.docs_url }}">{{ install.link }} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="steps">
        {% for step in install.steps %}
        <div class="step reveal" style="--i:{{ loop.index0 }}">
          <div class="step-head">
            <span class="step-n">{{ "%02d"|format(loop.index) }}</span>
            <h3>{{ step.title }}</h3>
            <button class="copy" type="button" data-copy="{{ install['copy'] }}" data-copied="{{ install['copied'] }}">{{ install["copy"] }}</button>
          </div>
          <pre tabindex="0" aria-label="{{ step.title }}"><code>{{ step.cmd }}</code></pre>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section faq" id="faq">
    <div class="wrap">
      <div class="fhead reveal">
        <div><p class="kicker">{{ faq.kicker | default("06 — FAQ") }}</p><h2>{{ faq.title }}</h2></div>
      </div>
      <div class="faq-list reveal">
        {% for item in faq["items"] %}
        <details>
          <summary>{{ item.q }}</summary>
          <p>{{ item.a }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap">
    <div class="foot-main">
      <div class="foot-brand"><span class="mark" aria-hidden="true">◈</span> {{ site.site_name }}</div>
      <p class="foot-tag">{{ footer.tagline }}</p>
    </div>
    <div class="foot-links">
      <a href="{{ site.docs_url }}">{{ footer.docs }}</a>
      <a href="{{ site.repo_url }}">{{ footer.source }}</a>
      <a href="{{ preview.sample_path }}">{{ footer.sample }}</a>
    </div>
    <div class="foot-legal">
      <span>{{ footer.author }} · {{ footer.license }} · {{ footer.version_label }} v{{ version }}</span>
      <span>{{ footer.rights }}</span>
    </div>
  </div>
</footer>

<script src="{{ asset_prefix }}assets/site.js?v={{ asset_version }}" defer></script>
</body>
</html>
